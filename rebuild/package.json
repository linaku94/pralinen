{
  "name": "pralinen-rebuild",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply pralinen --local",
    "db:remote": "wrangler d1 migrations apply pralinen --remote",
    "deploy": "npm run build && wrangler deploy",
    "content": "node scripts/import-content.mjs",
    "predev": "npm run content",
    "prebuild": "npm run content"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "hono": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "miniflare": "4.20260426.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22"
  }
}
